# --- App ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Postgres (Supabase, Neon, or Railway Postgres all work) ---
DATABASE_URL=postgres://user:password@host:5432/subscription_agent

# --- Google OAuth (console.cloud.google.com > APIs & Services > Credentials) ---
# Enable the Gmail API on the project first.
# Scopes needed: gmail.readonly, gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Anthropic (extracts merchant/amount/date from messy email text) ---
ANTHROPIC_API_KEY=

# --- Bitnob (virtual card issuing — freeze/unfreeze per subscription) ---
# Request API access at hello@withbitnob.com first; needs KYC (BVN) per cardholder.
BITNOB_API_KEY=
BITNOB_BASE_URL=https://sandboxapi.bitnob.co/api/v1

# --- Reminder timing ---
# How many days before a renewal to send the first "still want this?" notice
REMINDER_DAYS_BEFORE=3
# How many hours to wait for a reply before treating it as "no response"
GRACE_PERIOD_HOURS=48
# Shared secret for the external cron trigger (/api/cron/run?secret=...) — make this random
CRON_SECRET=change-this-too
